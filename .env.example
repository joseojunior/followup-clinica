# Banco exclusivo do sistema de follow-up. Este usuário precisa de permissões
# somente no schema followup.
DATABASE_URL=postgresql://followup_app:CHANGE_ME@host:5432/followup

# Banco do sistema principal. Crie um usuário PostgreSQL com SELECT apenas.
# Se as tabelas estiverem no mesmo projeto Supabase, as duas URLs podem ser iguais.
SOURCE_USUARIOS_SDR_DATABASE_URL=postgresql://followup_reader:CHANGE_ME@host:5432/principal
SOURCE_CLINICA_NOVA_DATABASE_URL=postgresql://followup_reader:CHANGE_ME@host:5432/principal

# Credenciais dos dois números: nunca expor no front-end.
WHATSAPP_SENDER_1_TOKEN=CHANGE_ME
WHATSAPP_SENDER_2_TOKEN=CHANGE_ME
WHATSAPP_API_BASE_URL=https://example.uazapi.com

# Segurança operacional. Mantenha dry_run até concluir o piloto controlado.
FOLLOWUP_SEND_MODE=dry_run
WORKER_API_KEY=CREATE_A_LONG_RANDOM_VALUE
UAZAPI_WEBHOOK_SECRET=CREATE_ANOTHER_LONG_RANDOM_VALUE
FOLLOWUP_APP_URL=http://localhost:3000
WORKER_POLL_MS=30000
WORKER_ENROLL_INTERVAL_MS=300000

# Inteligência operacional. A análise e o chat são ativados somente quando esta chave existir.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Docker / Portainer: web usa 3000 internamente; o worker usa http://web:3000.
APP_ROLE=web
FOLLOWUP_IMAGE=ghcr.io/joseojunior/followup-clinica:latest
FOLLOWUP_APP_HOST=app.leticiaatd.online
FOLLOWUP_API_HOST=followapi.leticiaatd.online

# Login administrativo via Supabase Auth. Use a chave pública/anon; nunca a service_role.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
